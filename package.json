{
  "name": "nightjar-recovery-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Credential-free Alexa+ inspired travel recovery simulation",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test",
    "smoke": "node scripts/smoke.mjs",
    "preview:export": "node scripts/export-preview.mjs",
    "demo:proof": "node scripts/demo-proof.mjs",
    "proof:crash": "node scripts/process-crash-proof.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "zod": "4.6.5"
  },
  "license": "MIT"
}
